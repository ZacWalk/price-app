# vcvars may replace VCPKG_ROOT after CI has restored packages with another root.
if(NOT "$ENV{CI_VCPKG_ROOT}" STREQUAL "")
    set(_project_vcpkg_root "$ENV{CI_VCPKG_ROOT}")
else()
    set(_project_vcpkg_root "$ENV{VCPKG_ROOT}")
endif()
if(NOT IS_ABSOLUTE "${_project_vcpkg_root}")
    message(FATAL_ERROR "Set CI_VCPKG_ROOT or VCPKG_ROOT to an absolute vcpkg root.")
endif()
get_filename_component(_project_vcpkg_root "${_project_vcpkg_root}" REALPATH)
set(_project_vcpkg_toolchain "${_project_vcpkg_root}/scripts/buildsystems/vcpkg.cmake")
if(NOT EXISTS "${_project_vcpkg_toolchain}" OR IS_DIRECTORY "${_project_vcpkg_toolchain}")
    message(FATAL_ERROR "Selected vcpkg root has no toolchain: ${_project_vcpkg_toolchain}")
endif()
if(DEFINED Z_VCPKG_ROOT_DIR AND NOT Z_VCPKG_ROOT_DIR STREQUAL _project_vcpkg_root)
    message(FATAL_ERROR "Cached vcpkg root differs from the selected root; reconfigure with cmake --fresh.")
endif()
set(ENV{VCPKG_ROOT} "${_project_vcpkg_root}")
message(STATUS "Selected vcpkg toolchain: ${_project_vcpkg_toolchain}")
include("${_project_vcpkg_toolchain}")
