include(FetchContent)
include("${CMAKE_CURRENT_LIST_DIR}/../.dd/dependencies.cmake")
set(crypto_manifest "${CMAKE_CURRENT_LIST_DIR}/dd-dependencies.json")
find_package(Git REQUIRED)
file(READ "${crypto_manifest}" crypto_dependencies)
file(SHA256 "${crypto_manifest}" crypto_manifest_hash)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${crypto_manifest}")
set(crypto_fingerprint "manifest_sha256=${crypto_manifest_hash}\n")

function(crypto_dependency name)
    string(REPLACE "-" "_" id "${name}")
    string(TOUPPER "${id}" upper)
    set(override "CRYPTO_SOURCE_${upper}")
    set(${override} "" CACHE PATH "Explicit pinned source override for ${name}; never automatic")
    string(JSON commit GET "${crypto_dependencies}" dependencies "${name}" commit)
    if(${override})
        get_filename_component(source "${${override}}" ABSOLUTE)
        if(NOT EXISTS "${source}/CMakeLists.txt")
            message(FATAL_ERROR "Invalid explicit ${override}: ${source}")
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
            OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        if(NOT head STREQUAL commit)
            message(FATAL_ERROR "${override} must be clean at recorded ${commit}; got ${head}. Update the pin deliberately after review.")
        endif()
        dd_check_dependency_source("${source}" "${commit}")
        message(STATUS "${name}: explicit local source ${source} at ${head}")
        set(mode "explicit-local")
    else()
        set(source "${CMAKE_BINARY_DIR}/_deps/${name}-${commit}-src")
        dd_check_dependency_source("${source}" "${commit}")
        dd_dependency_arguments("${crypto_manifest}" "${name}" acquisition)
        if(name STREQUAL "libcmlp")
            # dd's Git arguments end in GIT_CONFIG. Example data is not a
            # library dependency; disabling LFS also avoids checkout-hook writes.
            list(APPEND acquisition filter.lfs.process= filter.lfs.smudge=
                filter.lfs.clean= filter.lfs.required=false)
        endif()
        FetchContent_Declare(${id} ${acquisition} SOURCE_DIR "${source}"
            SOURCE_SUBDIR __crypto_manual_integration UPDATE_COMMAND "")
        FetchContent_MakeAvailable(${id})
        dd_check_dependency_source("${source}" "${commit}")
        set(mode "pinned")
    endif()
    # Function scope suppresses dependency CTest suites without changing our
    # parent's BUILD_TESTING setting. Examples stay outside the default build.
    set(BUILD_TESTING OFF)
    set(CMLP_BUILD_EXAMPLE OFF)
    add_subdirectory("${source}" "${CMAKE_BINARY_DIR}/_deps/${id}-build" EXCLUDE_FROM_ALL)
    set(crypto_fingerprint "${crypto_fingerprint}${name}=${commit};${mode};${source}\n" PARENT_SCOPE)
endfunction()
