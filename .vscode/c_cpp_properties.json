{
    "version": 4,
    "configurations": [
        {
            "name": "MSVC x64",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/../platform-h",
                "${workspaceFolder}/build/release/_deps/platform_h-src"
            ],
            "defines": [
                "WIN32",
                "NDEBUG",
                "_WINDOWS",
                "_UNICODE",
                "UNICODE"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ]
}
